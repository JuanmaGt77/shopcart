# Variables que usa docker compose. Copia este archivo a .env y cambia las claves.
# Son valores de ejemplo para desarrollo local, no son credenciales reales.

# --- SQL Server ---
# La clave de sa debe cumplir la política de SQL Server: 8+ caracteres con mayúsculas, minúsculas, números y símbolos
DB_SA_PASSWORD=Cambiar_Esta_Clave_1
DB_PORT=1433
DB_NAME=ShopCart

# Usuario con el que se conecta la API (solo tiene permiso EXECUTE sobre los SPs)
DB_APP_USER=shopcart_app
DB_APP_PASSWORD=Cambiar_Clave_App_1

# --- API ---
API_PORT=3000
# Secreto para firmar los access token (mínimo 32 caracteres). Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio-de-48-bytes
# Orígenes permitidos por CORS, separados por coma (el frontend de la fase 2 corre en 5173)
CORS_ORIGINS=http://localhost:5173
