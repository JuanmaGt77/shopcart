# Copia este archivo a .env (cp .env.example .env). Son valores de ejemplo para desarrollo local.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# --- Conexión de la API ---
# La API usa un usuario que solo puede ejecutar stored procedures (lo crea el script 040)
DB_HOST=localhost
DB_PORT=1433
DB_NAME=ShopCart
DB_USER=shopcart_app
DB_PASSWORD=Cambiar_Clave_App_1
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# --- Solo para "npm run db:setup" / "npm run db:reset" ---
# Usuario administrador con el que se crea la base y el login de la aplicación
DB_ADMIN_USER=sa
DB_ADMIN_PASSWORD=Cambiar_Esta_Clave_1

# --- Autenticación ---
# Mínimo 32 caracteres. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio-de-48-bytes
JWT_ACCESS_EXPIRA=15m
REFRESH_DIAS=7
# En producción (HTTPS) COOKIE_SECURE=true
COOKIE_SECURE=false
COOKIE_SAMESITE=strict

# --- HTTP ---
# Orígenes permitidos por CORS separados por coma (el frontend de la fase 2 corre en 5173)
CORS_ORIGINS=http://localhost:5173
# Número de proxies delante de la API (0 si se expone directo)
TRUST_PROXY=0
# Intentos FALLIDOS de login y registros permitidos por IP cada 15 minutos
RATE_LIMIT_LOGIN=10
RATE_LIMIT_REGISTRO=5

# Cada cuántos segundos se liberan las reservas de checkout vencidas
JOB_RESERVAS_SEGUNDOS=15
